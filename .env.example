# Copy this file to `.env` (or `.env.local`) and fill in the values.
# The real `.env*` files are gitignored; only this example is committed.
# On Vercel, add the same three variables under
# Project Settings -> Environment Variables.

# Resend: sends the contact form's emails (the message to me, and the
# confirmation to the visitor). Server-side only; keep it secret.
# Get it at https://resend.com -> API Keys -> Create API Key. The sending
# domain (mail.ahmedhive.com) must be verified under Domains.
RESEND_API_KEY = 

# Cloudflare Turnstile: the spam check on the contact form.
# Create a site at https://dash.cloudflare.com -> Turnstile -> Add widget, and
# add `localhost` and the production domain as hostnames.
# Site key: public (it is sent to the browser, hence NEXT_PUBLIC_).
NEXT_PUBLIC_TURNSTILE_SITE_KEY = 

# Turnstile secret key: server-side only; keep it secret. Shown next to the site
# key in the same Turnstile widget settings. The server uses it to verify each
# visitor's pass with Cloudflare before a message is sent.
TURNSTILE_SECRET_KEY = 
